// Cloudflare Workers: serves the built website (dist/) as static files, no server code.
// "name" must be the same as the Worker name in the Cloudflare dashboard.
{
  "name": "flowchart-generator",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
